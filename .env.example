# Template for the local .env, which is gitignored. Copy it and fill in:
#
#     cp .env.example .env
#
# Docker Compose reads .env automatically because it sits beside
# compose.dev.yaml, which passes these through to the backend service.
#
# The bare hot-reload loop (uv run uvicorn) does not read it, since the app
# deliberately has no python-dotenv dependency. Load it into the shell first:
#
#     set -a; source ../.env; set +a
#     uv run uvicorn app.main:app --reload

# Credentials for the Kroger Public API, which powers the pricing features.
# Create an app at https://developer.kroger.com to get a pair.
#
# Both are optional. Left empty, the pricing features switch themselves off
# and the rest of the app behaves exactly as it does without an account.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Where Kroger returns the browser after you sign in to let this app add to
# your cart. Only needed for that: prices work without it.
#
# It has to match a redirect URI registered on your Kroger app exactly, and it
# is this app's callback path on whatever address you reach it at:
#
#     https://recipes.your-tailnet.ts.net/api/cart/callback
#     http://localhost:8085/api/cart/callback          (the dev stack)
#
# Kroger checks it character for character, so a trailing slash is a different
# URI. Left empty, sending a list to a cart switches itself off.
KROGER_REDIRECT_URI=
